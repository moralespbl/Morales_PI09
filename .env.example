# Copiá este archivo como ".env" (sin .txt) y completá. NUNCA subas el .env a GitHub.

# --- Plataforma web ---
WEB_USER=tu_usuario
WEB_PASS=tu_clave
WEB_URL=https://mesaifa.netlify.app/

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gemini ---
GEMINI_API_KEY=

# --- Google Sheets ---
# JSON completo de la cuenta de servicio (en una línea) o la ruta a un archivo .json local
GOOGLE_SHEETS_CREDENTIALS_JSON=
# ID de la planilla: lo que está entre /d/ y /edit en su URL
GOOGLE_SHEET_ID=

# --- Opcionales ---
# WORKSHEET_NAME=Bonos
# GEMINI_MODEL=gemini-3.8-flash
# FAMILIAS=LECAPS,BONCAPS          # familias a incluir (vacío = todas)
# Ya vienen configurados para mesaifa.netlify.app; solo se pisan si la web cambia:
# WEB_POPUP_SELECTOR=               # botón que cierra el cartel emergente inicial (CSS)
# WEB_BONOS_SELECTOR=#tab-tasafija
# WEB_DOWNLOAD_SELECTOR=button.xbtn[onclick*="TASAFIJA"]
# WEB_USER_SELECTOR=#ag-email
# WEB_PASS_SELECTOR=#ag-pass
# WEB_SUBMIT_SELECTOR=
# PRECIO_MODO=auto                  # auto | texto | numero
